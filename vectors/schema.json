{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astro.ravisuhag.com/vectors/schema.json",
  "title": "astro wire test vector file",
  "type": "object",
  "required": ["schema_version", "standard", "package", "source"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "standard": { "type": "string", "minLength": 3 },
    "package": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
    "source": { "type": "string", "minLength": 3 },
    "note": { "type": "string" },
    "corpus": {
      "type": "array",
      "description": "Published corpus files this package is checked against, relative to vectors/.",
      "items": { "type": "string" }
    },
    "encode": { "type": "array", "items": { "$ref": "#/$defs/encodeVector" } },
    "decode": { "type": "array", "items": { "$ref": "#/$defs/decodeVector" } },
    "reject": { "type": "array", "items": { "$ref": "#/$defs/rejectVector" } },
    "sequence": { "type": "array", "items": { "$ref": "#/$defs/sequenceVector" } }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "clause": {
      "description": "Clause number within `doc`, or within the file's `standard` when `doc` is absent. A number or annex letter only, never a document name.",
      "type": "string", "minLength": 1, "pattern": "^[0-9A-Z][0-9A-Za-z.\\-]*$"
    },
    "doc": {
      "description": "The document `clause` refers to, when it is not the file's `standard`.",
      "type": "string", "minLength": 3
    },
    "derivation": {
      "description": "How the value was derived. A note that stops mid-sentence is not a derivation, so it must end in . ! or ?",
      "type": "string", "minLength": 10, "pattern": "[.!?]\\s*$"
    },
    "errorName": {
      "enum": [
        "truncated", "length_mismatch", "crc_mismatch", "field_out_of_range",
        "reserved_value", "unsupported_version", "trailing_data", "buffer_too_small",
        "header_check_failed"
      ]
    },
    "requires": {
      "type": "array",
      "items": { "enum": ["encode_into"] },
      "uniqueItems": true
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "config": {
      "type": "object",
      "description": "Channel-level agreement, not wire content.",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "encodeVector": {
      "type": "object",
      "required": ["name", "note", "fields", "want"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "clause": { "$ref": "#/$defs/clause" },
        "doc": { "$ref": "#/$defs/doc" },
        "source": { "type": "string" },
        "note": { "$ref": "#/$defs/derivation" },
        "requires": { "$ref": "#/$defs/requires" },
        "config": { "$ref": "#/$defs/config" },
        "fields": { "$ref": "#/$defs/fields" },
        "want": { "$ref": "#/$defs/hex" }
      }
    },
    "decodeVector": {
      "type": "object",
      "required": ["name", "note", "input", "fields"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "clause": { "$ref": "#/$defs/clause" },
        "doc": { "$ref": "#/$defs/doc" },
        "source": { "type": "string" },
        "note": { "$ref": "#/$defs/derivation" },
        "requires": { "$ref": "#/$defs/requires" },
        "config": { "$ref": "#/$defs/config" },
        "input": { "$ref": "#/$defs/hex" },
        "fields": { "$ref": "#/$defs/fields" }
      }
    },
    "rejectVector": {
      "type": "object",
      "required": ["name", "error"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["input"], "not": { "required": ["fields"] } },
        { "required": ["fields"], "not": { "required": ["input"] } }
      ],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "clause": { "$ref": "#/$defs/clause" },
        "doc": { "$ref": "#/$defs/doc" },
        "source": { "type": "string" },
        "note": { "type": "string" },
        "requires": { "$ref": "#/$defs/requires" },
        "config": { "$ref": "#/$defs/config" },
        "input": { "$ref": "#/$defs/hex" },
        "fields": { "$ref": "#/$defs/fields" },
        "buffer_len": { "type": "integer", "minimum": 0 },
        "at_octet": {
          "description": "Offset of the first octet a conforming decoder cannot get past. Optional; where present, refusing earlier or later is refusing for the wrong reason.",
          "type": "integer", "minimum": 0
        },
        "error": { "$ref": "#/$defs/errorName" }
      }
    },
    "sequenceVector": {
      "type": "object",
      "required": ["name", "note", "steps"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "clause": { "$ref": "#/$defs/clause" },
        "doc": { "$ref": "#/$defs/doc" },
        "source": { "type": "string" },
        "note": { "$ref": "#/$defs/derivation" },
        "config": { "$ref": "#/$defs/config" },
        "init": { "type": "object" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["call"],
            "additionalProperties": false,
            "properties": {
              "call": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "fields": { "$ref": "#/$defs/fields" },
              "want": { "$ref": "#/$defs/hex" },
              "want_state": { "type": "object" },
              "error": { "$ref": "#/$defs/errorName" }
            }
          }
        }
      }
    }
  }
}
